# ----------------------------------------------------------------------
# Variables de entorno del sitio PMFL
# Copia este archivo como .env y rellena los valores.
# El archivo .env NO se sube a git (está en .gitignore).
# ----------------------------------------------------------------------

# ---- Estadísticas en vivo (Cloob) -----------------------------------
# ID del torneo PMFL en Cloob y de la categoría/división.
# Cuando arranque una nueva temporada, actualiza estos valores.
#
# Temporada 2026 (en curso):
CLOOB_TOURNAMENT_ID=9b6db3f2-8418-4661-b0e0-e4390ca760a4
CLOOB_CATEGORY_ID=3f04084c-a069-4325-a02f-73dbb4a54049
#
# Temporada 2025 (histórico):
#   CLOOB_TOURNAMENT_ID=bc8db9e5-70a0-413e-ba6c-5ca1cd229e3c
#   CLOOB_CATEGORY_ID=m804k0vhd0ubn
#
# Segundos de caché de los datos (revalidación). Por defecto 60.
CLOOB_REVALIDATE=60

# ---- Cuenta de Cloob (opcional) --------------------------------------
# Solo para los datos que Cloob NO publica sin sesión: hoy, la POSICIÓN
# de cada jugador del roster. Sin esto el sitio funciona igual, pero la
# columna "Posición" queda oculta.
# La cuenta debe ser de la liga/torneo para ver todos los clubes; una de
# club solo vería el suyo.
CLOOB_EMAIL=
CLOOB_PASSWORD=
# Opcional: si la cuenta tiene varios roles, fija cuál usar. El id sale
# en los logs del contenedor al arrancar sesión.
CLOOB_CONTEXT_ID=

# ---- Formulario de contacto (Resend) --------------------------------
RESEND_API_KEY=
CONTACT_FROM=PMFL Contacto <contacto@pmfl.com.pa>
CONTACT_TO=pmfllogistica@gmail.com

# ---- Cloudinary (galería) --------------------------------------------
# El cloud name es público; la API key/secret son SECRETOS: no los subas a git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta raíz del proyecto. Cada álbum es una subcarpeta (pmfl/jornada-1).
# Mantenerla distinta por proyecto es lo que evita mezclar galerías cuando
# se comparte una misma cuenta de Cloudinary.
CLOUDINARY_FOLDER=pmfl

# ---- Paneles privados ------------------------------------------------
# Contraseña del área de fotógrafos (/adminfoto): álbumes y subida de fotos.
ADMIN_PASSWORD=
# Contraseña del panel de la liga (/admin): patrocinadores. Si se deja
# vacía se usa la de arriba, pero conviene que sean distintas.
ADMIN_LIGA_PASSWORD=
# Cadena larga y aleatoria para firmar la cookie de sesión. Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
